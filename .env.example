# URL base da API backend. Copie este arquivo para .env.local e ajuste o valor.
VITE_API_URL=http://localhost:8080

# Public key da Mercado Pago (Card Payment Brick em /inscricoes). Use a de
# sandbox em dev/teste; a de produção só entra em .env.production no deploy.
MERCADOPAGOKEY=TEST-public-key-aqui
